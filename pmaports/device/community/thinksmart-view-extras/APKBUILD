# Lenovo ThinkSmart View (CD-18781Y) helpers for postmarketOS
pkgname=thinksmart-view-extras
pkgver=1
pkgrel=2
pkgdesc="Lenovo ThinkSmart View: Wi-Fi boot guard, APSS watchdog for systemd, echo cancellation, noise suppression"
url="https://github.com/isilweo/thinksmart-view-mainline"
arch="noarch"
license="CC0-1.0"
options="!check"
subpackages="$pkgname-echo-cancel:echo_cancel $pkgname-noise-suppression:noise_suppression"
source="
	wifi-guard
	wifi-guard.service
	80-apss-watchdog.conf
	60-echo-cancel.conf
	61-noise-suppression.conf
	thinksmart-view-extras.preset
"

package() {
	install -Dm755 "$srcdir"/wifi-guard "$pkgdir"/usr/sbin/wifi-guard
	install -Dm644 "$srcdir"/wifi-guard.service \
		"$pkgdir"/usr/lib/systemd/system/wifi-guard.service
	install -Dm644 "$srcdir"/thinksmart-view-extras.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/80-thinksmart-view-extras.preset
	# The kernel needs patches 0031-0032 (APSS watchdog) for /dev/watchdog0.
	install -Dm644 "$srcdir"/80-apss-watchdog.conf \
		"$pkgdir"/usr/lib/systemd/system.conf.d/80-apss-watchdog.conf
}

echo_cancel() {
	pkgdesc="Lenovo ThinkSmart View: PipeWire WebRTC echo cancellation"
	depends="pipewire-echo-cancel pipewire-webrtc"
	install -Dm644 "$srcdir"/60-echo-cancel.conf \
		"$subpkgdir"/usr/share/pipewire/pipewire.conf.d/60-echo-cancel.conf
}

noise_suppression() {
	pkgdesc="Lenovo ThinkSmart View: RNNoise noise suppression after the echo canceller"
	depends="$pkgname-echo-cancel=$pkgver-r$pkgrel noise-suppression-for-voice pipewire-filter-graph-ladspa"
	install -Dm644 "$srcdir"/61-noise-suppression.conf \
		"$subpkgdir"/usr/share/pipewire/pipewire.conf.d/61-noise-suppression.conf
}
