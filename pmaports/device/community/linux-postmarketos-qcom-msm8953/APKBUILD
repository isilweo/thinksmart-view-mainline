a225d594edde81b5f096689acdbd23e2ef64c099d4bd60bc9d3c054160e408650f8c0f810d66e22d48f928ea172b764a3e25b6d8f8c538e782f4d40686dae12b  config-postmarketos-qcom-msm8953.aarch64
ae9d58047b867a905bfd189ffc6752305aa7cc92f413fdf365cb6c1e48bae354357b5db0ebe0461d28333ed0db78e60a4bc5b5b54e52e36fbcbd76f09743ab89  tsv-v7.0.9-r39.patch
"
