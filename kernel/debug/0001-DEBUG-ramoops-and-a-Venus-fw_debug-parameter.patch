From fcf903ef286bd26c80977e4ccceb954bcdad540d Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:16:15 +0100
Subject: [PATCH] DEBUG: ramoops and a Venus fw_debug parameter

Not for upstream. ramoops keeps the kernel log of a crash in
/sys/fs/pstore; fw_debug sets the Venus firmware debug levels.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts | 10 ++++++++++
 drivers/media/platform/qcom/venus/hfi_venus.c         |  2 ++
 2 files changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
index aae5f6e..438216a 100644
--- a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
+++ b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
@@ -761,6 +761,16 @@
  * a quirk. Supplies and pins follow the stock Lenovo DT (qcom,camera@0).
  */
 / {
+	reserved-memory {
+		ramoops@b0000000 {
+			compatible = "ramoops";
+			reg = <0x0 0xb0000000 0x0 0x100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+		};
+	};
+
 	cam_vdig: cam-vdig-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "cam_vdig";
diff --git a/drivers/media/platform/qcom/venus/hfi_venus.c b/drivers/media/platform/qcom/venus/hfi_venus.c
index 518e3e7..28c7b45 100644
--- a/drivers/media/platform/qcom/venus/hfi_venus.c
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c
@@ -133,6 +133,8 @@ struct venus_hfi_device {
 static bool venus_pkt_debug;
 int venus_fw_debug = HFI_DEBUG_MSG_ERROR | HFI_DEBUG_MSG_FATAL;
 static bool venus_fw_low_power_mode = true;
+module_param_named(fw_debug, venus_fw_debug, int, 0644);
+MODULE_PARM_DESC(fw_debug, "Firmware debug message levels, applied at core init");
 static int venus_hw_rsp_timeout = 1000;
 static bool venus_fw_coverage;
 
-- 
