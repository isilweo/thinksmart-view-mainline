From 25d4b2fd29b2742e5e5caa07a62a5f187944c6d9 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Wed, 25 Nov 2026 13:02:58 +0100
Subject: [PATCH 33/34] arm64: dts: qcom: apq8053-lenovo-cd-18781y: keep the WLAN
 I/O supply on

L12 is the VDD-IO supply of SDHC2, which carries the QCA9379 WLAN
card. The stock DT runs it at 1.8 V only and keeps it always on
(qcom,vdd-io-always-on). Do the same, so that powering the card down
does not drop its I/O supply and the host does not pick 2.95 V for it.

Assisted-by: Claude:claude-opus-5-5
Assisted-by: Codex:gpt-6.2-astra
---
 arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
index f856385..e3d3d64 100644
--- a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
+++ b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
@@ -518,7 +518,8 @@
 
 		pm8953_l12: l12 {
 			regulator-min-microvolt = <1800000>;
-			regulator-max-microvolt = <2950000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
 		};
 
 		pm8953_l13: l13 {
