From d56f585fe09215caf0905ee5fb4f9c68a5f6936a Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:56:46 +0100
Subject: [PATCH 23/28] iio: light: vcnl4000: autosuspend right after probe

The sensor stays powered after probe until the first read. Mark the
device busy and request autosuspend at the end of probe so it powers
down after VCNL4000_SLEEP_DELAY_MS like after any other access.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/iio/light/vcnl4000.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/iio/light/vcnl4000.c b/drivers/iio/light/vcnl4000.c
index c756126..fed7bbd 100644
--- a/drivers/iio/light/vcnl4000.c
+++ b/drivers/iio/light/vcnl4000.c
@@ -2056,6 +2056,8 @@ static int vcnl4000_probe(struct i2c_client *client)
 	pm_runtime_enable(&client->dev);
 	pm_runtime_set_autosuspend_delay(&client->dev, VCNL4000_SLEEP_DELAY_MS);
 	pm_runtime_use_autosuspend(&client->dev);
+	pm_runtime_mark_last_busy(&client->dev);
+	pm_request_autosuspend(&client->dev);
 
 	return 0;
 fail_poweroff:
