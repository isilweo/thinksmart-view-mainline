From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 18:00:00 +0100
Subject: [PATCH 32/34] arm64: dts: qcom: msm8953: Describe the APSS watchdog


The Lenovo firmware describes an APSS watchdog with bark and bite
interrupts on SPIs 3 and 4. Describe it with its sleep clock so Linux
can use the hardware to recover from hangs.

Assisted-by: Codex:gpt-6.2-astra
---
diff --git a/arch/arm64/boot/dts/qcom/msm8953.dtsi b/arch/arm64/boot/dts/qcom/msm8953.dtsi
--- a/arch/arm64/boot/dts/qcom/msm8953.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8953.dtsi
@@ -2899,6 +2899,14 @@
 			#interconnect-cells = <1>;
 		};
 
+		watchdog@b017000 {
+			compatible = "qcom,apss-wdt-msm8953", "qcom,kpss-wdt";
+			reg = <0x0b017000 0x1000>;
+			interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 4 IRQ_TYPE_EDGE_RISING>;
+			clocks = <&sleep_clk>;
+		};
+
 		cpr: power-controller@b018000 {
 			compatible = "qcom,msm8953-cpr4pd";
 
