From e21546c3bcbfb270d026f596d1b88bc3ead718de Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:16:15 +0100
Subject: [PATCH 10/22] media: ccs: implement enum_frame_size for the pixel
 array

libcamera takes the sensor resolutions from VIDIOC_SUBDEV_ENUM_FRAME_SIZE
on the pixel array and fails with "No image format found" when the
operation is missing.

The pixel array has one fixed size, so report it. The binner and scaler
sizes depend on crop/compose and keep returning -EINVAL.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/i2c/ccs/ccs-core.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/media/i2c/ccs/ccs-core.c b/drivers/media/i2c/ccs/ccs-core.c
index 8e25f97..b208117 100644
--- a/drivers/media/i2c/ccs/ccs-core.c
+++ b/drivers/media/i2c/ccs/ccs-core.c
@@ -2586,6 +2586,32 @@ static void ccs_get_native_size(struct ccs_subdev *ssd, struct v4l2_rect *r)
 	r->height = CCS_LIM(ssd->sensor, Y_ADDR_MAX) + 1;
 }
 
+/*
+ * libcamera (CameraSensorLegacy) takes the sensor sizes from ENUM_FRAME_SIZE on
+ * the pixel array, which ccs did not implement ("No image format found"). The
+ * pixel array has one fixed size; the binner and scaler sizes depend on
+ * crop/compose, so they keep returning -EINVAL.
+ */
+static int ccs_enum_frame_size(struct v4l2_subdev *subdev,
+			       struct v4l2_subdev_state *sd_state,
+			       struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct ccs_sensor *sensor = to_ccs_sensor(subdev);
+	struct v4l2_rect r;
+
+	if (subdev != &sensor->pixel_array->sd || fse->index ||
+	    fse->code != sensor->internal_csi_format->code)
+		return -EINVAL;
+
+	ccs_get_native_size(sensor->pixel_array, &r);
+	fse->min_width = r.width;
+	fse->max_width = r.width;
+	fse->min_height = r.height;
+	fse->max_height = r.height;
+
+	return 0;
+}
+
 static int ccs_get_selection(struct v4l2_subdev *subdev,
 			     struct v4l2_subdev_state *sd_state,
 			     struct v4l2_subdev_selection *sel)
@@ -3108,6 +3134,7 @@ static const struct v4l2_subdev_video_ops ccs_video_ops = {
 
 static const struct v4l2_subdev_pad_ops ccs_pad_ops = {
 	.enum_mbus_code = ccs_enum_mbus_code,
+	.enum_frame_size = ccs_enum_frame_size,
 	.get_fmt = ccs_get_format,
 	.set_fmt = ccs_set_format,
 	.get_selection = ccs_get_selection,
