From fbe1c66569f0591f9f7a3f9e86375144ebda6422 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:16:15 +0100
Subject: [PATCH 14/22] media: qcom: camss: make the MSM8953 VFE capture full
 frames

NOT FOR UPSTREAM AS IS: this collects what was needed to get complete
RDI frames from the VFE on MSM8953 and needs to be reworked into proper
per-SoC resources and DT bindings.

- QoS and DS settings from the stock DT,
- VBIF QoS (0x124 = 3) by briefly mapping the VBIF register, as the
  qcom,msm8953-camss binding has no VBIF region,
- VFE0 UB size of 2048 words (VFE40_UB_SIZE_8952) instead of 1024,
- frame based WR_BUFFER_CFG for the write master, as the vendor
  msm_vfe40_axi_cfg_wm_reg does; without it frames tear or get cut,
- a VFE clock floor of 266.67 MHz; the computed rate (about 45 MHz for
  RDI) cannot keep up and drops lines.

Assisted-by: Claude:claude-opus-5-5
---
 .../media/platform/qcom/camss/camss-vfe-4-1.c | 15 +++++-
 .../platform/qcom/camss/camss-vfe-gen1.c      | 46 +++++++++++++++++++
 drivers/media/platform/qcom/camss/camss-vfe.c | 17 +++++++
 3 files changed, 77 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-4-1.c b/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
index 9cf1ccd..90b9a1c 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-4-1.c
@@ -736,6 +736,12 @@ static void vfe_set_qos(struct vfe_device *vfe)
 	u32 val7 = VFE_0_BUS_BDG_QOS_CFG_7_CFG;
 	int ret;
 
+	/* MSM8953: qos-settings from the stock DT; VBIF in vfe_enable_output() */
+	if (vfe->camss->res->version == CAMSS_8x53) {
+		val = 0xaa55aa55;
+		val7 = 0xaa55aa55;
+	}
+
 	writel_relaxed(val, vfe->base + VFE_0_BUS_BDG_QOS_CFG_0);
 	writel_relaxed(val, vfe->base + VFE_0_BUS_BDG_QOS_CFG_1);
 	writel_relaxed(val, vfe->base + VFE_0_BUS_BDG_QOS_CFG_2);
@@ -758,7 +764,14 @@ static void vfe_set_qos(struct vfe_device *vfe)
 
 static void vfe_set_ds(struct vfe_device *vfe)
 {
-	/* empty */
+	/* MSM8953: ds-regs/ds-settings from the stock DT */
+	if (vfe->camss->res->version == CAMSS_8x53) {
+		u32 r;
+
+		for (r = 0x988; r < 0x9c8; r += 4)
+			writel_relaxed(0xcccc1111, vfe->base + r);
+		writel_relaxed(0x110, vfe->base + 0x9c8);
+	}
 }
 
 static void vfe_set_cgc_override(struct vfe_device *vfe, u8 wm, u8 enable)
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
index d84a375..a733508 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -7,6 +7,8 @@
  * Copyright (C) 2020 Linaro Ltd.
  */
 
+#include <linux/io.h>
+
 #include "camss.h"
 #include "camss-vfe.h"
 #include "camss-vfe-gen1.h"
@@ -165,6 +167,29 @@ static void vfe_output_frame_drop(struct vfe_device *vfe,
 	vfe->res->hw_ops->reg_update(vfe, container_of(output, struct vfe_line, output)->id);
 }
 
+/*
+ * MSM8953: camera VBIF as in the stock DT (qcom,vbif-qos-setting: 0x124 = 3).
+ * camss has has_vbif/vbif_name for this, but the qcom,msm8953-camss binding
+ * has no VBIF region in reg-names and vfe_vbif_apply_settings() writes the
+ * 8939 values. HACK: map this one register briefly instead of changing the
+ * binding and DTSI; ioremap may sleep, so this runs before output_lock.
+ */
+static void vfe_8x53_set_vbif(struct vfe_device *vfe)
+{
+	static const phys_addr_t vbif[] = { 0x1b40000, 0x1ba0000 };
+	void __iomem *vb;
+
+	if (vfe->id >= ARRAY_SIZE(vbif))
+		return;
+
+	vb = ioremap(vbif[vfe->id], 0x200);
+	if (!vb)
+		return;
+
+	writel_relaxed(3, vb + 0x124);
+	iounmap(vb);
+}
+
 static int vfe_enable_output(struct vfe_line *line)
 {
 	struct vfe_device *vfe = to_vfe(line);
@@ -180,6 +205,13 @@ static int vfe_enable_output(struct vfe_line *line)
 	if (!ub_size)
 		return -EINVAL;
 
+	/* MSM8953: the VFE0 UB is 2048 words (VFE40_UB_SIZE_8952), 8916 has 1024 */
+	if (vfe->camss->res->version == CAMSS_8x53 && vfe->id == 0)
+		ub_size = 2047 / 3;
+
+	if (vfe->camss->res->version == CAMSS_8x53)
+		vfe_8x53_set_vbif(vfe);
+
 	sensor_pad = camss_find_sensor_pad(&line->subdev.entity);
 	if (sensor_pad) {
 		struct v4l2_subdev *subdev =
@@ -245,6 +277,20 @@ static int vfe_enable_output(struct vfe_line *line)
 		vfe->ops_gen1->wm_set_ub_cfg(vfe, output->wm_idx[0],
 					    (ub_size + 1) * output->wm_idx[0], ub_size);
 		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
+		/*
+		 * MSM8953: VFE_0_BUS_IMAGE_MASTER_n_WR_BUFFER_CFG(n) from
+		 * camss-vfe-4-1.c, as msm_vfe40_axi_cfg_wm_reg does (frame based):
+		 * 64-bit words per line << 16 | (height - 1) << 4 | burst 3. Without
+		 * it the VFE does not know the frame bounds (tearing, cut frames).
+		 */
+		if (vfe->camss->res->version == CAMSS_8x53) {
+			struct v4l2_pix_format_mplane *pix =
+				&line->video_out.active_fmt.fmt.pix_mp;
+			u32 wpl = DIV_ROUND_UP(pix->plane_fmt[0].bytesperline, 8);
+
+			writel_relaxed(wpl << 16 | (pix->height - 1) << 4 | 3,
+				       vfe->base + 0x084 + 0x24 * output->wm_idx[0]);
+		}
 		vfe->ops_gen1->wm_enable(vfe, output->wm_idx[0], 1);
 		vfe->ops_gen1->bus_reload_wm(vfe, output->wm_idx[0]);
 	} else {
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 6451891..78f2c85 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -964,6 +964,19 @@ static void vfe_clamp_pixel_rate(struct vfe_device *vfe,
 	*pix_rate = min(*pix_rate, (u64) mult_frac(link_freq, 2 * lanes, bpp));
 }
 
+/*
+ * MSM8953: the stock software keeps the VFE at 266.67 MHz. The computed rate
+ * (~45 MHz for RDI) cannot keep up with the memory writes and lines get
+ * dropped. The floor is applied before camss_add_clock_margin(), so the level
+ * picked is one above stock (tested and working; lower was not tried).
+ */
+static void vfe_8x53_min_rate(struct vfe_device *vfe, u64 *min_rate)
+{
+	if (vfe->camss->res->version == CAMSS_8x53 && *min_rate &&
+	    *min_rate < 266670000)
+		*min_rate = 266670000;
+}
+
 /*
  * vfe_set_clock_rates - Calculate and set clock rates on VFE module
  * @vfe: VFE device
@@ -1021,6 +1034,8 @@ static int vfe_set_clock_rates(struct vfe_device *vfe)
 					min_rate = tmp;
 			}
 
+			vfe_8x53_min_rate(vfe, &min_rate);
+
 			camss_add_clock_margin(&min_rate);
 
 			for (j = 0; j < clock->nfreqs; j++)
@@ -1113,6 +1128,8 @@ static int vfe_check_clock_rates(struct vfe_device *vfe)
 					min_rate = tmp;
 			}
 
+			vfe_8x53_min_rate(vfe, &min_rate);
+
 			camss_add_clock_margin(&min_rate);
 
 			rate = clk_get_rate(clock->clk);
-- 
