From c31f32c984e5baddbfecb461df3b51d8667ffb34 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 19:38:36 +0100
Subject: [PATCH 14/34] media: qcom: camss: read the link frequency from the
 transmitter

camss_get_link_freq() looks up the link frequency on the first entity
upstream with the camera sensor function. For a sensor made of several
subdevs, such as ccs (pixel array and binner or scaler), that is the pixel
array, while V4L2_CID_LINK_FREQ lives on the subdev connected to the
CSIPHY. v4l2_get_link_freq() then falls back to the pixel rate and warns
"Consider implementing support for V4L2_CID_LINK_FREQ in the transmitter
driver".

Use the first subdev upstream that does not belong to camss, which is the
transmitter. Single-subdev sensors are unaffected. With a bridge between
the sensor and the CSIPHY this now reads the bridge, which drives the
link camss receives.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/camss/camss.c | 38 +++++++++++++++++++----
 1 file changed, 32 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index eba1fa7..d9050d8 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -4271,24 +4271,50 @@ struct media_pad *camss_find_sensor_pad(struct media_entity *entity)
 	}
 }
 
+/*
+ * The transmitter is the first subdev upstream that does not belong to camss.
+ * For a sensor made of several subdevs (e.g. ccs) this is the one connected
+ * to the CSIPHY, which owns the link frequency, not the sensor entity.
+ */
+static struct media_pad *camss_find_transmitter_pad(struct media_entity *entity)
+{
+	struct device *dev = media_entity_to_v4l2_subdev(entity)->dev;
+	struct media_pad *pad;
+
+	while (1) {
+		pad = &entity->pads[0];
+		if (!(pad->flags & MEDIA_PAD_FL_SINK))
+			return NULL;
+
+		pad = media_pad_remote_pad_first(pad);
+		if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+			return NULL;
+
+		entity = pad->entity;
+
+		if (media_entity_to_v4l2_subdev(entity)->dev != dev)
+			return pad;
+	}
+}
+
 /**
- * camss_get_link_freq - Get link frequency from sensor
+ * camss_get_link_freq - Get link frequency from the transmitter
  * @entity: Media entity in the current pipeline
  * @bpp: Number of bits per pixel for the current format
- * @lanes: Number of lanes in the link to the sensor
+ * @lanes: Number of lanes in the link to the transmitter
  *
  * Return link frequency on success or a negative error code otherwise
  */
 s64 camss_get_link_freq(struct media_entity *entity, unsigned int bpp,
 			unsigned int lanes)
 {
-	struct media_pad *sensor_pad;
+	struct media_pad *pad;
 
-	sensor_pad = camss_find_sensor_pad(entity);
-	if (!sensor_pad)
+	pad = camss_find_transmitter_pad(entity);
+	if (!pad)
 		return -ENODEV;
 
-	return v4l2_get_link_freq(sensor_pad, bpp, 2 * lanes);
+	return v4l2_get_link_freq(pad, bpp, 2 * lanes);
 }
 
 /*
