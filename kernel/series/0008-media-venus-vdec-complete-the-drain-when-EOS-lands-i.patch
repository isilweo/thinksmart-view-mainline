From 993e033e60e7d23e5b9590a4df154704f937cf44 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 19:38:36 +0100
Subject: [PATCH 08/32] media: venus: vdec: complete the drain when EOS lands
 in a held buffer

When userspace is slow to return capture buffers (READONLY frames, slow
consumer) the firmware can report EOS in a buffer that is not queued in
the driver. venus_helper_find_buf() returns NULL, the LAST flag is lost
and the drain never completes, so gst-launch -e never exits.

Remember the pending EOS and flag the next queued capture buffer as
LAST.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/venus/core.h |  2 ++
 drivers/media/platform/qcom/venus/vdec.c | 18 ++++++++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index 7506f5d..73e32c4 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -446,6 +446,7 @@ enum venus_inst_modes {
  * @bit_depth:		current bitstream bit-depth
  * @pic_struct:		bitstream progressive vs interlaced
  * @next_buf_last: a flag to mark next queued capture buffer as last
+ * @eos_last_pending: EOS came in a buffer still held by userspace
  * @drain_active:	Drain sequence is in progress
  * @flags:	bitmask flags describing current instance mode
  * @dpb_ids:	DPB buffer ID's
@@ -517,6 +518,7 @@ struct venus_inst {
 	unsigned int bit_depth;
 	unsigned int pic_struct;
 	bool next_buf_last;
+	bool eos_last_pending;
 	bool drain_active;
 	enum venus_inst_modes flags;
 	struct ida dpb_ids;
diff --git a/drivers/media/platform/qcom/venus/vdec.c b/drivers/media/platform/qcom/venus/vdec.c
index 7a3247d..530292c 100644
--- a/drivers/media/platform/qcom/venus/vdec.c
+++ b/drivers/media/platform/qcom/venus/vdec.c
@@ -1076,6 +1076,7 @@ reconfigure:
 	venus_pm_load_scale(inst);
 
 	inst->next_buf_last = false;
+	inst->eos_last_pending = false;
 
 	ret = venus_helper_alloc_dpb_bufs(inst);
 	if (ret)
@@ -1147,6 +1148,7 @@ static int vdec_start_output(struct venus_inst *inst)
 	inst->sequence_out = 0;
 	inst->reconfig = false;
 	inst->next_buf_last = false;
+	inst->eos_last_pending = false;
 
 	ret = vdec_set_properties(inst);
 	if (ret)
@@ -1383,8 +1385,10 @@ static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 
 	mutex_lock(&inst->lock);
 
-	if (inst->next_buf_last && V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) &&
-	    inst->codec_state == VENUS_DEC_STATE_DRC) {
+	if (V4L2_TYPE_IS_CAPTURE(vb->vb2_queue->type) &&
+	    ((inst->next_buf_last && inst->codec_state == VENUS_DEC_STATE_DRC) ||
+	     (inst->eos_last_pending &&
+	      inst->codec_state == VENUS_DEC_STATE_STOPPED))) {
 		vbuf->flags |= V4L2_BUF_FLAG_LAST;
 		vbuf->sequence = inst->sequence_cap++;
 		vbuf->field = V4L2_FIELD_NONE;
@@ -1392,6 +1396,7 @@ static void vdec_vb2_buf_queue(struct vb2_buffer *vb)
 		v4l2_m2m_buf_done(vbuf, VB2_BUF_STATE_DONE);
 		v4l2_event_queue_fh(&inst->fh, &eos);
 		inst->next_buf_last = false;
+		inst->eos_last_pending = false;
 		mutex_unlock(&inst->lock);
 		return;
 	}
@@ -1429,6 +1434,15 @@ static void vdec_buf_done(struct venus_inst *inst, unsigned int buf_type,
 	vbuf = venus_helper_find_buf(inst, type, tag);
 	if (!vbuf) {
 		venus_helper_change_dpb_owner(inst, vbuf, type, buf_type, tag);
+		/* EOS in a buffer still held by userspace: flag the next one */
+		if (type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE &&
+		    (flags & V4L2_BUF_FLAG_LAST) && inst->streamon_cap &&
+		    inst->sequence_cap &&
+		    inst->codec_state == VENUS_DEC_STATE_DRAIN) {
+			inst->drain_active = false;
+			inst->codec_state = VENUS_DEC_STATE_STOPPED;
+			inst->eos_last_pending = true;
+		}
 		return;
 	}
 
