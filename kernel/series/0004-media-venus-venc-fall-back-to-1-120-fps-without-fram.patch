From 00210e0fc9fe51653a045526cde162fb6012ac7e Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:56:46 +0100
Subject: [PATCH 04/28] media: venus: venc: fall back to 1-120 fps without
 frame rate caps

The MSM8953 firmware VIDEO.VE.4.2 reports no HFI_CAPABILITY_FRAMERATE for
the encoder, so VIDIOC_ENUM_FRAMEINTERVALS returned a zero denominator and
GStreamer's v4l2h264enc stalled during caps negotiation.

Report 1-120 fps when the firmware gives no range.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/venus/venc.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index efcec72..998ae0f 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -473,6 +473,7 @@ static int venc_enum_frameintervals(struct file *file, void *fh,
 	struct venus_inst *inst = to_inst(file);
 	const struct venus_format *fmt;
 	unsigned int framerate_factor = 1;
+	u32 fmin, fmax;
 
 	fival->type = V4L2_FRMIVAL_TYPE_STEPWISE;
 
@@ -502,12 +503,20 @@ static int venc_enum_frameintervals(struct file *file, void *fh,
 		framerate_factor = (1 << 16);
 	}
 
+	/* some firmware reports no frame rate range for the encoder */
+	fmin = frate_min(inst) / framerate_factor;
+	fmax = frate_max(inst) / framerate_factor;
+	if (!fmin || !fmax) {
+		fmin = 1;
+		fmax = 120;
+	}
+
 	fival->stepwise.min.numerator = 1;
-	fival->stepwise.min.denominator = frate_max(inst) / framerate_factor;
+	fival->stepwise.min.denominator = fmax;
 	fival->stepwise.max.numerator = 1;
-	fival->stepwise.max.denominator = frate_min(inst) / framerate_factor;
+	fival->stepwise.max.denominator = fmin;
 	fival->stepwise.step.numerator = 1;
-	fival->stepwise.step.denominator = frate_max(inst) / framerate_factor;
+	fival->stepwise.step.denominator = fmax;
 
 	return 0;
 }
