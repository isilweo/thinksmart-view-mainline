From 6564835fb3bffba1277b554603a1e87cc6571492 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 19:38:36 +0100
Subject: [PATCH 12/34] media: qcom: camss: do not walk into multi-subdev
 sensors

video_start_streaming() calls s_stream on every subdev up the pipeline.
A sensor made of several subdevs (ccs: binner and pixel array) starts
its internal pipeline itself through enable_streams, and calling s_stream
on its internal subdevs fails.

Stop at the first subdev outside camss (camss subdevs have no ->dev),
which is the sensor, on start and stop.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/camss/camss-video.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 831486e..507ab09 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -275,6 +275,10 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 		ret = v4l2_subdev_call(subdev, video, s_stream, 1);
 		if (ret < 0 && ret != -ENOIOCTLCMD)
 			goto error;
+
+		/* stop at the sensor, it starts its own internal subdevs */
+		if (subdev->dev && subdev->dev != video->camss->dev)
+			break;
 	}
 
 	return 0;
@@ -316,6 +320,9 @@ static void video_stop_streaming(struct vb2_queue *q)
 			dev_err(video->camss->dev, "Video pipeline stop failed: %d\n", ret);
 			return;
 		}
+
+		if (subdev->dev && subdev->dev != video->camss->dev)
+			break;
 	}
 
 	video_device_pipeline_stop(vdev);
