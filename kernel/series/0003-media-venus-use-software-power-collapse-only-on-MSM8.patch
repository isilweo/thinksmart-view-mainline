From 205099c77bf1caccd29c381701e413df1a04fed5 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 19:38:35 +0100
Subject: [PATCH 03/34] media: venus: use software power collapse only on
 MSM8953

The vendor kernel uses software power collapse only on MSM8953 (Venus
3.x). Sending SYS_POWER_CONTROL and handing the vcodec power control to
the hardware made the encoder hang mid-stream every so often (VPP never
going idle).

Skip SYS_POWER_CONTROL and keep the vcodec power control under software
control for qcom,msm8953-venus.

HACK: matching the compatible in the driver is not the right way; this
should become a flag in the per-SoC resources.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/venus/hfi_venus.c  | 12 ++++++++----
 drivers/media/platform/qcom/venus/pm_helpers.c |  5 +++++
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/hfi_venus.c b/drivers/media/platform/qcom/venus/hfi_venus.c
index bd82066..ec0632e 100644
--- a/drivers/media/platform/qcom/venus/hfi_venus.c
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c
@@ -10,6 +10,7 @@
 #include <linux/interrupt.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/of.h>
 #include <linux/slab.h>
 
 #include "core.h"
@@ -960,10 +961,13 @@ static int venus_sys_set_default_properties(struct venus_hfi_device *hdev)
 			dev_warn(dev, "setting idle response ON failed (%d)\n", ret);
 	}
 
-	ret = venus_sys_set_power_control(hdev, venus_fw_low_power_mode);
-	if (ret)
-		dev_warn(dev, "setting hw power collapse ON failed (%d)\n",
-			 ret);
+	/* MSM8953 only supports software power collapse */
+	if (!of_device_is_compatible(dev->of_node, "qcom,msm8953-venus")) {
+		ret = venus_sys_set_power_control(hdev, venus_fw_low_power_mode);
+		if (ret)
+			dev_warn(dev, "setting hw power collapse ON failed (%d)\n",
+				 ret);
+	}
 
 	/* For specific venus core, it is mandatory to set the UBWC configuration */
 	if (res->ubwc_conf) {
diff --git a/drivers/media/platform/qcom/venus/pm_helpers.c b/drivers/media/platform/qcom/venus/pm_helpers.c
index f026952..e027146 100644
--- a/drivers/media/platform/qcom/venus/pm_helpers.c
+++ b/drivers/media/platform/qcom/venus/pm_helpers.c
@@ -8,6 +8,7 @@
 #include <linux/interconnect.h>
 #include <linux/iopoll.h>
 #include <linux/kernel.h>
+#include <linux/of.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_opp.h>
 #include <linux/pm_runtime.h>
@@ -345,6 +346,10 @@ vcodec_control_v3(struct venus_core *core, u32 session_type, bool enable)
 	else
 		ctrl = core->wrapper_base + WRAPPER_VENC_VCODEC_POWER_CONTROL;
 
+	/* MSM8953 only supports software power collapse */
+	if (of_device_is_compatible(core->dev->of_node, "qcom,msm8953-venus"))
+		enable = true;
+
 	if (enable)
 		writel(0, ctrl);
 	else
