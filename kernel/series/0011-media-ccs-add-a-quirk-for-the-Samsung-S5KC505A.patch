From 9fd7bed3b6e8fcdb80406a2f2bb01c177b369a35 Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:54:26 +0100
Subject: [PATCH 11/28] media: ccs: add a quirk for the Samsung S5KC505A

The S5KC505A (front camera of the Lenovo ThinkSmart View) identifies as
CCS 0.8 with module ident 0x00/0x5034. Its clock limit registers are
incomplete and it needs a vendor init sequence.

Add a quirk that:
- declares the dual PLL tree and lane speed based calculation,
- sets line and frame blanking as in the stock mode (with the reported
  minimums the VFE misses lines and the start of frame),
- keeps the VT PLL at 550-600 MHz; at 384 MHz the ADC ramp does not
  complete and white clips at about 286,
- writes the init and mode register tables after power on.

The register tables were extracted from the stock Lenovo
libmmcamera_s5kc505a.so. The same tables are already published under
GPL-2.0 in rebrch/tsv-nura:

https://github.com/rebrch/tsv-nura/blob/32e84a9f4bf5cbbefc2135b1bf5b57b37e036ae3/camera/driver/s5kc505a_regs.h

The init table is identical to s5kc505a_global and the mode table is a
subset of s5kc505a_2608x1960. Their meaning is not
documented; they are the vendor's power-on and mode sequence.

Tested with libcamera SoftISP: 1304x980 (binned in the sensor) preview
at 27-30 fps.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/i2c/ccs/ccs-core.c  |   1 +
 drivers/media/i2c/ccs/ccs-quirk.c | 146 ++++++++++++++++++++++++++++++
 drivers/media/i2c/ccs/ccs-quirk.h |   1 +
 3 files changed, 148 insertions(+)

diff --git a/drivers/media/i2c/ccs/ccs-core.c b/drivers/media/i2c/ccs/ccs-core.c
index b208117..bab425c 100644
--- a/drivers/media/i2c/ccs/ccs-core.c
+++ b/drivers/media/i2c/ccs/ccs-core.c
@@ -48,6 +48,7 @@ static struct ccs_limit_offset {
  * ccs_module_idents - supported camera modules
  */
 static const struct ccs_module_ident ccs_module_idents[] = {
+	CCS_IDENT_LQ(0x00, 0x5034, -1, "s5kc505a", &smiapp_s5kc505a_quirk),
 	CCS_IDENT_L(0x01, 0x022b, -1, "vs6555"),
 	CCS_IDENT_L(0x01, 0x022e, -1, "vw6558"),
 	CCS_IDENT_L(0x07, 0x7698, -1, "ovm7698"),
diff --git a/drivers/media/i2c/ccs/ccs-quirk.c b/drivers/media/i2c/ccs/ccs-quirk.c
index e48a4fa..769b0d8 100644
--- a/drivers/media/i2c/ccs/ccs-quirk.c
+++ b/drivers/media/i2c/ccs/ccs-quirk.c
@@ -215,3 +215,149 @@ static int tcm8500md_limits(struct ccs_sensor *sensor)
 const struct ccs_quirk smiapp_tcm8500md_quirk = {
 	.limits = tcm8500md_limits,
 };
+
+/*
+ * Samsung S5KC505A (Lenovo ThinkSmart View CD-18781Y).
+ * The clock limit registers are incomplete. The sensor has two PLLs (VT and
+ * OP, CCS registers 0x0305/0x0306 and 0x030d/0x030e) and a 2-lane 960 Mb/s
+ * link. Register tables come from the stock Lenovo libmmcamera_s5kc505a.so.
+ */
+static int s5kc505a_limits(struct ccs_sensor *sensor)
+{
+	ccs_replace_limit(sensor, CCS_L_CLOCK_TREE_PLL_CAPABILITY, 0,
+			  CCS_CLOCK_TREE_PLL_CAPABILITY_DUAL_PLL);
+	ccs_replace_limit(sensor, CCS_L_CLOCK_CALCULATION, 0,
+			  CCS_CLOCK_CALCULATION_LANE_SPEED);
+	/* stock mode: line length 3112 = 2608 + 504; with 192 the VFE drops lines */
+	ccs_replace_limit(sensor, CCS_L_MIN_LINE_BLANKING_PCK, 0, 504);
+	/*
+	 * stock mode: 2030 lines for 1960 visible. With 25 blanking lines the VFE
+	 * misses the start of frame and the image rolls by ~176 rows per frame.
+	 */
+	ccs_replace_limit(sensor, CCS_L_MIN_FRAME_BLANKING_LINES, 0, 70);
+	/*
+	 * VT PLL: stock 24/4*95 = 570 MHz, vt_pix_div 6. At 384 MHz (24/3*48,
+	 * div 4) the ADC ramp does not complete and white clips at ~286 (8 bits
+	 * + 32), so force 550-600 MHz. The *_MHZ limits are IEEE 754 floats.
+	 */
+	ccs_replace_limit(sensor, CCS_L_MIN_PLL_OP_CLK_FREQ_MHZ, 0, 0x44098000); /* 550 */
+	ccs_replace_limit(sensor, CCS_L_MAX_PLL_OP_CLK_FREQ_MHZ, 0, 0x44160000); /* 600 */
+	ccs_replace_limit(sensor, CCS_L_MIN_VT_SYS_CLK_DIV, 0, 1);
+	ccs_replace_limit(sensor, CCS_L_MAX_VT_SYS_CLK_DIV, 0, 1);
+	ccs_replace_limit(sensor, CCS_L_MIN_VT_SYS_CLK_FREQ_MHZ, 0, 0x42c80000); /* 100 */
+	ccs_replace_limit(sensor, CCS_L_MAX_VT_SYS_CLK_FREQ_MHZ, 0, 0x447a0000); /* 1000 */
+	ccs_replace_limit(sensor, CCS_L_MAX_VT_PIX_CLK_FREQ_MHZ, 0, 0x43480000); /* 200 */
+	ccs_replace_limit(sensor, CCS_L_MIN_OP_SYS_CLK_DIV, 0, 1);
+	ccs_replace_limit(sensor, CCS_L_MAX_OP_SYS_CLK_DIV, 0, 1);
+	ccs_replace_limit(sensor, CCS_L_MIN_OP_SYS_CLK_FREQ_MHZ, 0, 0x42c80000); /* 100 */
+	ccs_replace_limit(sensor, CCS_L_MAX_OP_SYS_CLK_FREQ_MHZ, 0, 0x447a0000); /* 1000 */
+	ccs_replace_limit(sensor, CCS_L_MIN_OP_PIX_CLK_DIV, 0, 8);
+	ccs_replace_limit(sensor, CCS_L_MAX_OP_PIX_CLK_DIV, 0, 10);
+	ccs_replace_limit(sensor, CCS_L_MIN_OP_PIX_CLK_FREQ_MHZ, 0, 0x41200000); /* 10 */
+	ccs_replace_limit(sensor, CCS_L_MAX_OP_PIX_CLK_FREQ_MHZ, 0, 0x43480000); /* 200 */
+	return 0;
+}
+
+/*
+ * ccs_write_addr_8s() above passes bare addresses, but cci_write() needs the
+ * register width, so write the S5KC505A tables through CCI_REG8().
+ */
+static int s5kc505a_write(struct ccs_sensor *sensor,
+			  const struct ccs_reg_8 *regs, int len)
+{
+	int rval;
+
+	for (; len > 0; len--, regs++) {
+		rval = ccs_write_addr(sensor, CCI_REG8(regs->reg), regs->val);
+		if (rval)
+			return rval;
+	}
+
+	return 0;
+}
+
+static int s5kc505a_post_poweron(struct ccs_sensor *sensor)
+{
+	static const struct ccs_reg_8 init[] = {
+		{ 0x0a02, 0x0f },
+		{ 0x340f, 0x80 },
+		{ 0x3457, 0x04 },
+		{ 0x3419, 0x00 },
+		{ 0x3416, 0x40 },
+		{ 0x3418, 0x00 },
+		{ 0x3419, 0x04 },
+		{ 0x3419, 0x00 },
+		{ 0x3416, 0x40 },
+		{ 0x3418, 0x24 },
+		{ 0x3419, 0x04 },
+		{ 0x3419, 0x00 },
+		{ 0x3416, 0x40 },
+		{ 0x3418, 0x48 },
+		{ 0x3419, 0x04 },
+		{ 0x3419, 0x00 },
+		{ 0x3416, 0x40 },
+		{ 0x3418, 0x6c },
+		{ 0x3419, 0x04 },
+		{ 0x3419, 0x00 },
+		{ 0x3457, 0x0c },
+		{ 0x3457, 0x04 },
+		{ 0x307c, 0x16 },
+		{ 0x3087, 0xdc },
+		{ 0x3089, 0x0a },
+		{ 0x308b, 0x08 },
+		{ 0x308c, 0x0b },
+		{ 0x308e, 0x36 },
+		{ 0x3075, 0x4d },
+		{ 0x306f, 0xa8 },
+		{ 0x306a, 0x79 },
+		{ 0x3077, 0x10 },
+		{ 0x30b0, 0xc8 },
+		{ 0x3078, 0x17 },
+		{ 0x3070, 0x0f },
+		{ 0x0b00, 0x01 },
+		{ 0x0801, 0x10 },
+		{ 0x0804, 0x10 },
+		{ 0x3931, 0x02 },
+		{ 0x3930, 0x80 },
+		{ 0x3932, 0x60 },
+	};
+	static const struct ccs_reg_8 mode[] = {
+		{ 0x3c17, 0x00 },
+		{ 0x3c1f, 0x00 },
+		{ 0x0820, 0x03 },
+		{ 0x0821, 0xc0 },
+		{ 0x0b05, 0x01 },
+		{ 0x3303, 0x02 },
+		{ 0x3301, 0x00 },
+		{ 0x3400, 0x00 },
+		{ 0x0b00, 0x00 },
+		{ 0x3459, 0x75 },
+		{ 0x3c0f, 0x01 },
+		{ 0x300f, 0x01 },
+		{ 0x3010, 0x77 },
+		{ 0x3014, 0x01 },
+		{ 0x3015, 0x86 },
+		{ 0x3929, 0x07 },
+		{ 0x3906, 0x76 },
+		{ 0x3c02, 0x00 },
+		{ 0x3c03, 0xff },
+	};
+	int rval;
+
+	/* the stock table waits 10 ms after the first write */
+	rval = s5kc505a_write(sensor, init, 1);
+	if (rval)
+		return rval;
+	usleep_range(10000, 11000);
+
+	rval = s5kc505a_write(sensor, init + 1, ARRAY_SIZE(init) - 1);
+	if (rval)
+		return rval;
+
+	return s5kc505a_write(sensor, mode, ARRAY_SIZE(mode));
+}
+
+const struct ccs_quirk smiapp_s5kc505a_quirk = {
+	.limits = s5kc505a_limits,
+	.post_poweron = s5kc505a_post_poweron,
+};
diff --git a/drivers/media/i2c/ccs/ccs-quirk.h b/drivers/media/i2c/ccs/ccs-quirk.h
index 392c971..7d7aaca 100644
--- a/drivers/media/i2c/ccs/ccs-quirk.h
+++ b/drivers/media/i2c/ccs/ccs-quirk.h
@@ -75,5 +75,6 @@ extern const struct ccs_quirk smiapp_jt8ev1_quirk;
 extern const struct ccs_quirk smiapp_imx125es_quirk;
 extern const struct ccs_quirk smiapp_jt8ew9_quirk;
 extern const struct ccs_quirk smiapp_tcm8500md_quirk;
+extern const struct ccs_quirk smiapp_s5kc505a_quirk;
 
 #endif /* __CCS_QUIRK__ */
