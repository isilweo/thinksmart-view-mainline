From c2c80fc63ce9d81249ee77faed5c7de77a56068d Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 14:16:15 +0100
Subject: [PATCH 18/22] arm64: dts: qcom: apq8053-lenovo-cd-18781y: enable both
 touchscreens

The ThinkSmart View ships with either a FocalTech FT8201 or a Himax
HX83100A touch controller. Enable both nodes; the one that is not
fitted fails to probe.

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
index cecb92f..0487c33 100644
--- a/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
+++ b/arch/arm64/boot/dts/qcom/apq8053-lenovo-cd-18781y.dts
@@ -287,7 +287,7 @@
 		touchscreen-size-x = <800>;
 		touchscreen-size-y = <1280>;
 
-		status = "disabled";
+		status = "okay"; /* both variants exist; the absent one fails to probe */
 	};
 
 	hx83100a_ts: touchscreen@48 {
@@ -309,7 +309,7 @@
 		touchscreen-size-x = <800>;
 		touchscreen-size-y = <1280>;
 
-		status = "disabled";
+		status = "okay"; /* both variants exist; the absent one fails to probe */
 	};
 };
 
