From f063bc4ff39277d6dfc933bffcfb422ffd79c66e Mon Sep 17 00:00:00 2001
From: Lech Piekarski <isilweo@gmail.com>
Date: Tue, 24 Nov 2026 19:38:35 +0100
Subject: [PATCH 02/34] media: venus: hfi_parser: tolerate a truncated last
 property

The MSM8953 firmware VIDEO.VE.4.2 sends a SYS_INIT_DONE packet whose last
property (CAPS) is 8 bytes short (2576 byte packet). hfi_parser() then
returned HFI_ERR_SYS_INSUFFICIENT_RESOURCES and the whole core was
rejected, leaving neither encoder nor decoder.

Warn once and stop parsing at the truncated property instead.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/venus/hfi_parser.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/venus/hfi_parser.c b/drivers/media/platform/qcom/venus/hfi_parser.c
index a139776..2598212 100644
--- a/drivers/media/platform/qcom/venus/hfi_parser.c
+++ b/drivers/media/platform/qcom/venus/hfi_parser.c
@@ -385,9 +385,16 @@ u32 hfi_parser(struct venus_core *core, struct venus_inst *inst, void *buf,
 			break;
 		}
 
-		if (ret < 0 || rem_bytes < ret)
+		if (ret < 0)
 			return HFI_ERR_SYS_INSUFFICIENT_RESOURCES;
 
+		/* VE.4.2 firmware on MSM8953 truncates the last property */
+		if (rem_bytes < ret) {
+			dev_warn_once(core->dev, "Truncated property %x, ignoring the rest\n",
+				      property);
+			break;
+		}
+
 		words += ret / sizeof(u32);
 		rem_bytes -= ret;
 	}
